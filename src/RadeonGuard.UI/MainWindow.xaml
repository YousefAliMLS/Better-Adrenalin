<ui:FluentWindow x:Class="RadeonGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:RadeonGuard.UI.Controls"
        Title="RadeonGuard — Reliable AMD GPU &amp; Fan Manager"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="680"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True">

    <Grid Background="#12141A">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="RadeonGuard — Standalone AMD GPU &amp; Fan Control">
            <ui:TitleBar.Header>
                <Border Background="#1F232E" CornerRadius="6" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F59E0B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GuardianConnected}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusBanner}" Foreground="#D1D5DB" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Tabbed Shell (True Left Sidebar + Full-Height Content) -->
        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="8">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="195" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#161922" BorderBrush="#262A36" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,10,0">
                            <StackPanel IsItemsHost="True" Orientation="Vertical" />
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#9CA3AF" />
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="Margin" Value="0,2,8,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#26ED1C24" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1E222D" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 1. DASHBOARD -->
            <TabItem Header="  Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <!-- Hardware Header Card -->
                        <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding GpuName}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding GpuVramInfo}" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0" />
                                    <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,4,0,0">
                                        <Run Text="Driver: " /><Run Text="{Binding GpuDriverVersion, Mode=OneWay}" />
                                        <Run Text="  •  VBIOS: " /><Run Text="{Binding GpuBiosVersion, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#242936" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE PROFILE &amp; HARDWARE SYNC" FontSize="10" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0">
                                                <Run Text="{Binding ActiveTuningName, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#6B7280" />
                                                <Run Text="{Binding ActiveFanName, Mode=OneWay}" Foreground="#F87171" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding HardwareSyncState}" FontSize="12" Foreground="#34D399" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ActiveGameText, StringFormat='Active Game: {0}'}" FontSize="12" Foreground="#D1D5DB" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Telemetry Grid -->
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="GPU TEMPERATURE (EDGE / HOTSPOT)" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,6,0,6">
                                        <Run Text="{Binding EdgeTempC, StringFormat='{}{0:F1}°C', Mode=OneWay}" />
                                        <Run Text=" / " Foreground="#6B7280" FontSize="18" />
                                        <Run Text="{Binding HotspotTempC, StringFormat='{}{0:F1}°C', Mode=OneWay}" Foreground="#F59E0B" FontSize="20" />
                                    </TextBlock>
                                    <controls:SparklineChartControl Height="42" Values="{Binding TempHistory}" StrokeColor="#F59E0B" MaxValue="110" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="GPU UTILIZATION &amp; CORE CLOCK" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,6,0,6">
                                        <Run Text="{Binding GpuUsagePercent, StringFormat='{}{0:F0}%', Mode=OneWay}" />
                                        <Run Text=" • " Foreground="#6B7280" FontSize="18" />
                                        <Run Text="{Binding GpuClockMHz, StringFormat='{}{0} MHz', Mode=OneWay}" Foreground="#EF4444" FontSize="20" />
                                    </TextBlock>
                                    <controls:SparklineChartControl Height="42" Values="{Binding UsageHistory}" StrokeColor="#EF4444" MaxValue="100" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="TOTAL BOARD POWER &amp; VOLTAGE" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,6,0,6">
                                        <Run Text="{Binding BoardPowerW, StringFormat='{}{0:F0} W', Mode=OneWay}" />
                                        <Run Text=" • " Foreground="#6B7280" FontSize="18" />
                                        <Run Text="{Binding VoltageMv, StringFormat='{}{0} mV', Mode=OneWay}" Foreground="#60A5FA" FontSize="20" />
                                    </TextBlock>
                                    <controls:SparklineChartControl Height="42" Values="{Binding PowerHistory}" StrokeColor="#60A5FA" MaxValue="350" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="VRAM CLOCK &amp; DEDICATED USAGE" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,6,0,0">
                                        <Run Text="{Binding VramClockMHz, StringFormat='{}{0} MHz', Mode=OneWay}" />
                                        <Run Text=" • " Foreground="#6B7280" FontSize="16" />
                                        <Run Text="{Binding VramUsedMb, StringFormat='{}{0} MB', Mode=OneWay}" Foreground="#A78BFA" FontSize="18" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="FAN TACHOMETER" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FanRpm, StringFormat='{}{0} RPM'}" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="GUARDIAN SERVICE CONTROL" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button Content="Start Guardian" Appearance="Primary" Command="{Binding StartGuardianCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="Refresh All" Command="{Binding LoadAllDataCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ADLX HARDWARE-REPORTED TUNING LIMITS" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HardwareRangesSummary}" FontSize="13" Foreground="#E5E7EB" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. FAN CONTROL -->
            <TabItem Header="  Fan Control">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Saved Fan Profiles List -->
                    <Border Grid.Column="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,14,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Saved Fan Profiles" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{Binding ActiveFanName, StringFormat='Active on GPU: {0}'}" FontSize="11.5" Foreground="#34D399" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button Content="+ New" Appearance="Primary" Command="{Binding NewFanProfileCommand}" Margin="0,0,6,0" />
                                <ui:Button Content="Duplicate" Command="{Binding DuplicateFanProfileCommand}" Margin="0,0,6,0" />
                                <ui:Button Content="Delete" Appearance="Danger" Command="{Binding DeleteFanProfileCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding FanProfiles}" SelectedItem="{Binding SelectedFanProfile}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RevisionNumber, StringFormat='Rev {0} • Permanent SQLite'}" FontSize="11" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Fan Curve Editor -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Profile Name" FontSize="12" Foreground="#9CA3AF" />
                                            <ui:TextBox Text="{Binding EditFanName, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <ui:Button Content="Save Only" Command="{Binding SaveFanOnlyCommand}" Margin="0,0,8,0" />
                                            <ui:Button Content="Save &amp; Apply to GPU" Appearance="Primary" Command="{Binding SaveAndApplyFanCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,12,0,0">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <ui:Button Content="Export Selected (.json / .xml)" Command="{Binding ExportSelectedFanProfileCommand}" Margin="0,0,8,0" />
                                            <ui:Button Content="Export All (.json)" Command="{Binding ExportAllFanProfilesCommand}" Margin="0,0,8,0" />
                                            <ui:Button Content="Import &amp; Apply (.json / .xml)" Appearance="Secondary" Command="{Binding ImportAndApplyFanProfilesCommand}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                         IsChecked="{Binding AutoStartWithWindows}"
                                                         Content="Keep Applied After PC Restart" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding FanValidationMessage}" Foreground="#34D399" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Interactive 5-Point Hardware Fan Curve (Junction/Hotspot Temp °C vs PWM %)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
                                    <controls:FanCurveCanvasControl x:Name="FanCurveEditor"
                                                                      Height="290"
                                                                      Points="{Binding EditFanPoints}"
                                                                      LiveHotspotTemp="{Binding HotspotTempC}" />
                                    <TextBlock Text="Tip: Drag any point above or edit values below. RDNA 2 SMU evaluates the curve against Hotspot (Junction) temperature." FontSize="11.5" Foreground="#9CA3AF" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding EditFanPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#232732" CornerRadius="6" Padding="8" Margin="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Index, StringFormat='Point {0}'}" Foreground="#F87171" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="Temp (°C)" FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,0" />
                                                        <ui:NumberBox Value="{Binding TemperatureC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="20" Maximum="110" />
                                                        <TextBlock Text="Fan (%)" FontSize="11" Foreground="#9CA3AF" Margin="0,6,0,0" />
                                                        <ui:NumberBox Value="{Binding FanSpeedPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="4,12,0,0">
                                        <ui:ToggleSwitch IsChecked="{Binding EditFanZeroRpm}" Content="Zero RPM Mode (Silent Idle)" Margin="0,0,24,0" />
                                        <ui:ToggleSwitch IsChecked="{Binding EditFanUseMinAcoustic}" Content="Override Min Acoustic Limit (MHz)" Margin="0,0,12,0" />
                                        <ui:NumberBox Value="{Binding EditFanMinAcoustic, Mode=TwoWay}" Minimum="500" Maximum="2500" Width="130" IsEnabled="{Binding EditFanUseMinAcoustic}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#222632" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock Text="{Binding FanValidationMessage}" Foreground="#E5E7EB" FontSize="12.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 3. GPU TUNING -->
            <TabItem Header="  GPU Tuning">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,14,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tuning Profiles" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button Content="+ New" Appearance="Primary" Command="{Binding NewTuningProfileCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Delete" Appearance="Danger" Command="{Binding DeleteTuningProfileCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding TuningProfiles}" SelectedItem="{Binding SelectedTuningProfile}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RevisionNumber, StringFormat='Rev {0}'}" FontSize="11" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tuning Profile Name" FontSize="12" Foreground="#9CA3AF" />
                                        <ui:TextBox Text="{Binding EditTuningName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Margin="0,4,0,8" />
                                        <TextBlock Text="Linked Fan Profile" FontSize="12" Foreground="#9CA3AF" />
                                        <ComboBox ItemsSource="{Binding FanProfiles}" SelectedValue="{Binding EditLinkedFanProfileId}" SelectedValuePath="FanProfileId" DisplayMemberPath="Name" Width="300" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Save Only" Command="{Binding SaveTuningOnlyCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="Save &amp; Apply" Appearance="Primary" Command="{Binding SaveAndApplyTuningCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Visibility="{Binding EditTuningIsQuarantined, Converter={StaticResource BoolToVis}}"
                                    Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <TextBlock Text="{Binding EditTuningQuarantineReason, StringFormat='QUARANTINED: {0} Saving clears quarantine after review.'}" Foreground="#FCA5A5" TextWrapping="Wrap" />
                            </Border>

                            <UniformGrid Columns="2">
                                <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,10">
                                    <StackPanel>
                                        <ui:ToggleSwitch IsChecked="{Binding EditEnableClock}" Content="Manual GPU Core Frequency (MHz)" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Min Frequency (MHz)" FontSize="11.5" Foreground="#9CA3AF" />
                                        <ui:NumberBox Value="{Binding EditMinCoreClock, Mode=TwoWay}" Minimum="300" Maximum="3000" IsEnabled="{Binding EditEnableClock}" Margin="0,2,0,8" />
                                        <TextBlock Text="Max Frequency (MHz)" FontSize="11.5" Foreground="#9CA3AF" />
                                        <ui:NumberBox Value="{Binding EditMaxCoreClock, Mode=TwoWay}" Minimum="300" Maximum="3200" IsEnabled="{Binding EditEnableClock}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <ui:ToggleSwitch IsChecked="{Binding EditEnableVoltage}" Content="Manual Core Voltage (mV)" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Target Voltage (mV)" FontSize="11.5" Foreground="#9CA3AF" />
                                        <ui:NumberBox Value="{Binding EditCoreVoltage, Mode=TwoWay}" Minimum="600" Maximum="1300" IsEnabled="{Binding EditEnableVoltage}" Margin="0,2,0,10" />
                                        <ui:ToggleSwitch IsChecked="{Binding EditEnablePower}" Content="Manual Power Limit (%)" FontWeight="SemiBold" Margin="0,6,0,6" />
                                        <ui:NumberBox Value="{Binding EditPowerLimitDelta, Mode=TwoWay}" Minimum="-50" Maximum="50" IsEnabled="{Binding EditEnablePower}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,10">
                                    <StackPanel>
                                        <ui:ToggleSwitch IsChecked="{Binding EditEnableVram}" Content="Manual VRAM Tuning" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="Max VRAM Frequency (MHz)" FontSize="11.5" Foreground="#9CA3AF" />
                                        <ui:NumberBox Value="{Binding EditMaxVramClock, Mode=TwoWay}" Minimum="500" Maximum="3000" IsEnabled="{Binding EditEnableVram}" Margin="0,2,0,8" />
                                        <TextBlock Text="VRAM Memory Timing" FontSize="11.5" Foreground="#9CA3AF" />
                                        <ComboBox ItemsSource="{Binding VramTimingModes}" SelectedItem="{Binding EditVramTiming}" IsEnabled="{Binding EditEnableVram}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="ADLX 3D Driver Settings (Applied on Switch)" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                        <ui:ToggleSwitch IsChecked="{Binding EditAntiLag}" Content="Radeon Anti-Lag" Margin="0,2" />
                                        <ui:ToggleSwitch IsChecked="{Binding EditEnhancedSync}" Content="Radeon Enhanced Sync" Margin="0,2" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <ui:ToggleSwitch IsChecked="{Binding EditImageSharpening}" Content="Image Sharpening (%)" Margin="0,0,10,0" />
                                            <ui:NumberBox Value="{Binding EditSharpeningPercent, Mode=TwoWay}" Minimum="0" Maximum="100" Width="90" IsEnabled="{Binding EditImageSharpening}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <ui:ToggleSwitch IsChecked="{Binding EditFrtc}" Content="Frame Rate Target (FRTC)" Margin="0,0,10,0" />
                                            <ui:NumberBox Value="{Binding EditFrtcFps, Mode=TwoWay}" Minimum="30" Maximum="360" Width="90" IsEnabled="{Binding EditFrtc}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <ui:ToggleSwitch IsChecked="{Binding EditChill}" Content="Radeon Chill (Min/Max)" Margin="0,0,8,0" />
                                            <ui:NumberBox Value="{Binding EditChillMinFps, Mode=TwoWay}" Minimum="30" Maximum="300" Width="78" IsEnabled="{Binding EditChill}" Margin="0,0,4,0" />
                                            <ui:NumberBox Value="{Binding EditChillMaxFps, Mode=TwoWay}" Minimum="30" Maximum="300" Width="78" IsEnabled="{Binding EditChill}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="#222632" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock Text="{Binding TuningFeedbackMessage}" Foreground="#E5E7EB" FontSize="12.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 4. GAME PROFILES & DENYLIST -->
            <TabItem Header="  Game Profiles">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,14,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Registered Games" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <ui:Button Content="Import Adrenalin" Appearance="Primary" Command="{Binding ImportFromAdrenalinCommand}" Margin="0,0,6,6" />
                                    <ui:Button Content="Scan Launchers" Command="{Binding RescanLaunchersCommand}" Margin="0,0,6,6" />
                                    <ui:Button Content="+ Add .EXE" Command="{Binding AddManualGameCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedGameProfile}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LauncherSource}" FontSize="11" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Game Profile Binding" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
                                    <TextBlock Text="Game Title" FontSize="12" Foreground="#9CA3AF" />
                                    <ui:TextBox Text="{Binding EditGameTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                                    <TextBlock Text="Primary Renderer Executable" FontSize="12" Foreground="#9CA3AF" />
                                    <ui:TextBox Text="{Binding EditGameExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                                    <UniformGrid Columns="2" Margin="0,4,0,8">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Assigned Tuning Profile" FontSize="12" Foreground="#9CA3AF" />
                                            <ComboBox ItemsSource="{Binding TuningProfiles}" SelectedValue="{Binding EditGameTuningId}" SelectedValuePath="TuningProfileId" DisplayMemberPath="Name" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Optional Fan Profile Override" FontSize="12" Foreground="#9CA3AF" />
                                            <ComboBox ItemsSource="{Binding GameFanOverrideOptions}" SelectedValue="{Binding EditGameFanOverrideId}" SelectedValuePath="FanProfileId" DisplayMemberPath="DisplayName" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Per-Game Zero RPM Mode (Prevents Fan Cycling on Light Games)" FontSize="12" Foreground="#9CA3AF" />
                                        <ComboBox ItemsSource="{Binding ZeroRpmOverrideOptions}" SelectedValue="{Binding EditGameZeroRpmOverride}" SelectedValuePath="Mode" DisplayMemberPath="DisplayName" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <ui:ToggleSwitch IsChecked="{Binding EditGameEnabled}" Content="Enable Automatic Switching for This Game" Margin="0,6" />
                                    <ui:ToggleSwitch IsChecked="{Binding EditGameLockRunning}" Content="Lock Profile While Process Is Running (Alt-Tab Immune)" Margin="0,2,0,12" />

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Save Game Profile" Appearance="Primary" Command="{Binding SaveGameProfileCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="Remove Game" Appearance="Danger" Command="{Binding DeleteGameProfileCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding GameImportFeedback}" Foreground="#34D399" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Non-Game Denylist -->
                            <Border Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Non-Game Denylist (Blocks Python, Zoom, Office, Browsers from Hijacking Profiles)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:TextBox PlaceholderText="e.g. blender.exe" Text="{Binding NewDenylistExe, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0" />
                                        <ui:TextBox PlaceholderText="Reason" Text="{Binding NewDenylistReason, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,0" />
                                        <ui:Button Content="Add to Denylist" Command="{Binding AddDenylistCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Denylist}" MaxHeight="200" Background="#14161D" BorderThickness="1" BorderBrush="#2D313E">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ExeFileName}" Foreground="#FCA5A5" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" Foreground="#9CA3AF" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 5. HISTORY & BACKUPS -->
            <TabItem Header="  History &amp; Backups">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <ui:Button Content="Create Atomic Backup Now" Appearance="Primary" Command="{Binding CreateBackupNowCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Export Bundle (.json)" Command="{Binding ExportBundleCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Import (.json / .xml)" Command="{Binding ImportBundleCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Refresh" Command="{Binding RefreshHistoryAndBackupsCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding HistoryFeedback}" Foreground="#34D399" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Immutable Configuration Revision History (Click Rollback)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding Revisions}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Foreground="White" FontWeight="SemiBold">
                                                        <Run Text="{Binding EntityType, Mode=OneWay}" />
                                                        <Run Text=" • Rev #" />
                                                        <Run Text="{Binding RevisionNumber, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ChangeReason}" Foreground="#9CA3AF" FontSize="11.5" />
                                                    <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:u}'}" Foreground="#6B7280" FontSize="11" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="Rollback" VerticalAlignment="Center"
                                                           Command="{Binding DataContext.RollbackRevisionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="SQLite VACUUM Snapshots (SHA-256 Verified)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding Backups}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FilePath}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="#9CA3AF">
                                                        <Run Text="{Binding CreatedAtUtc, StringFormat='{}{0:u}', Mode=OneWay}" />
                                                        <Run Text=" • Checksum Valid: " />
                                                        <Run Text="{Binding ChecksumValid, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="Restore" VerticalAlignment="Center"
                                                           Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 6. RELIABILITY & DIAGNOSTICS -->
            <TabItem Header="  Diagnostics">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Left" Content="Run Live System &amp; Conflict Scan" Appearance="Primary" Command="{Binding RunDiagnosticsCommand}" Margin="0,0,16,0" />
                            <ui:ToggleSwitch IsChecked="{Binding AutoReapplyOnConflict}" Content="Auto Re-Apply Profile When External Drift / Reset Is Detected" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Detected Processes, AMD Services &amp; Recommendations" FontSize="13.5" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding ConflictingProcesses}" MaxHeight="120" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" />
                                    <TextBlock Text="Recommendations &amp; TDR Event Log (Event ID 4101)" FontSize="12" Foreground="#F59E0B" Margin="0,6,0,2" />
                                    <ListBox ItemsSource="{Binding DiagnosticRecommendations}" MaxHeight="90" Background="Transparent" BorderThickness="0" Foreground="#FDE68A" />
                                    <ListBox ItemsSource="{Binding TdrEvents}" MaxHeight="70" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="8,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Hardware Sync Audit Log (SAVED vs APPLIED vs VERIFIED vs DRIFTED)" FontSize="13.5" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding AuditLog}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3">
                                                <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold">
                                                    <Run Text="{Binding ApplyStatus, Mode=OneWay}" Foreground="#34D399" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding TargetProfileName, Mode=OneWay}" />
                                                    <Run Text=" / " />
                                                    <Run Text="{Binding TargetFanProfileName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="#9CA3AF" FontSize="11">
                                                    <Run Text="{Binding TriggerReason, Mode=OneWay}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding TimestampUtc, StringFormat='{}{0:u}', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#1B1E26" BorderBrush="#2D313E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Flight-Recorder Logs" FontSize="13.5" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                <ListBox ItemsSource="{Binding FlightLogs}" Background="#12141A" BorderThickness="0" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="11.5" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
